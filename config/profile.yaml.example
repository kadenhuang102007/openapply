# Copy to config/profile.yaml (gitignored) and edit. openapply never stores passwords.

name:
  first: Jane
  last: Doe
  preferred: Jane
email: jane_doe@university.edu
phone: "(555)-555-0100"
linkedin: https://www.linkedin.com/in/janedoe
github: https://github.com/janedoe
website: ""
location: City, ST
school: Your University
degree: B.S.
majors: [Data Science]
graduation: May 2028

# Mailing address for Workday's "My Information" step. Blank fields are left for you.
address:
  line1: ""
  line2: ""
  city: City
  state: ST              # two-letter code or full name
  postal_code: ""
  country: United States
phone_type: Mobile       # Workday's "Phone Device Type"
# Workday's "How did you hear about us?" is left alone unless you set this (e.g. LinkedIn).
how_did_you_hear: ""

# Structured education and work history, typed into Workday's repeating sections.
# Dates: "Month YYYY" (or "YYYY"); end: Present = "I currently work here".
education:
  - school: Your University
    degree: B.S.
    field_of_study: Data Science
    start: August 2025
    end: May 2028
experience:
  - company: Example Corp
    title: Software Engineering Intern
    location: ""         # blank if you don't want to give one
    start: June 2026
    end: August 2026     # or Present
    description: Built an internal dashboard in Python and SQL used by the support team.

# Saved answers (config/answers.yaml) for work authorization, sponsorship and EEO /
# self-identification questions are only auto-filled when this is true.
use_saved_answers: false

# Auto-submit (off by default). When true, `openapply apply <id> --submit`, `openapply add`
# and `openapply autopilot` submit ONLY if every guardrail passes (all required fields filled,
# no CAPTCHA, no [YOUR WORDS placeholders, fabrication check passed, established company and
# score >= auto_submit_min_score, under the daily limit, not applied before, Workday on Review
# with no errors). Otherwise they stop and add the job to `openapply todo`.
auto_submit: false
auto_submit_min_score: 60
auto_submit_daily_limit: 10

# Phone number for `openapply daily` iMessage alerts.
alert_phone: "+15555550100"
alerts:
  min_score: 0   # only alert on new jobs with a baseline score >= this

# Only show and alert on internships at established companies (big tech, top
# public / late-stage tech, quant firms, major finance, large enterprises), as
# listed in config/company_tiers.yaml. Startups are kept in the database with
# the reason "not an established company"; `openapply rank --include-startups`
# shows them anyway, and `--established-only` works even when this is false.
established_only: false

# Fill these in yourself. openapply uses needs_sponsorship_now_or_future only to
# filter out "no sponsorship" postings. Answers typed into forms come from
# config/answers.yaml, and only with use_saved_answers: true.
work_authorization:
  authorized_to_work_in_us: ""          # yes / no
  needs_sponsorship_now_or_future: ""   # yes / no

# Demographic / EEO answers are never stored here. Optional saved answers live in config/answers.yaml.

# Resume variants. `families` decides which resume goes with which role family.
resumes:
  variants:
    pm:
      label: PM / Growth (Master)
      path: resumes/Resume_PM.tex
      pdf: resumes/Resume_PM.pdf
      families: [pm]
    swe_data:
      label: SWE / Data
      path: resumes/Resume_SWE.tex
      pdf: resumes/Resume_SWE.pdf
      families: [swe, ds, ml]

# Common open-ended questions `openapply tailor` drafts answers for.
# {company} and {title} are filled in per job.
questions:
  - Why are you interested in this role at {company}?
  - Tell us about a project you're proud of.
  - Describe a time you used data to make a decision.
  - What would you hope to learn during this internship?

# Google Sheet sync (`openapply export --to sheets`). The sheet id can also be
# set as GOOGLE_SHEET_ID in .env.
sheets:
  sheet_id: ""
  worksheet: ""        # blank = first tab
  yes_value: "Yes"     # what your sheet uses for a checked box ("Yes", "TRUE", "x", ...)
